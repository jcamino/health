---
// Reusable medical disclaimer. The specialist phrase links to a localized Google Maps search.
const mapsHref =
  "https://www.google.com/maps/search/?api=1&query=preventive+cardiologist";
---

<aside class="notice not-prose">
  <p class="notice-label">Educational only — not medical advice</p>
  <p>
    These tools illustrate concepts and estimates and can't account for your
    full history. Discuss your numbers with a
    <a
      class="underline underline-offset-2 hover:text-blood"
      href={mapsHref}
      target="_blank"
      rel="noopener noreferrer"
      >preventive cardiologist or clinical lipidologist</a
    >.
  </p>
</aside>
