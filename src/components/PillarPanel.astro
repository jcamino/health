---
// The homepage's pillar directory, styled as a lab requisition panel: each
// pillar is a numbered row with its markers and an honest status stamp. The
// numbering is the site's own taxonomy (Pillar 0–4), not decoration.
type Status = "open" | "draft" | "planned";

const pillars: {
  n: string;
  name: string;
  href: string | null;
  status: Status;
  markers: string;
}[] = [
  {
    n: "00",
    name: "Foundations",
    href: null,
    status: "planned",
    markers:
      "nutrition · exercise (VO₂max + strength) · sleep · emotional & social health",
  },
  {
    n: "01",
    name: "Heart",
    href: "/heart/",
    status: "open",
    markers: "ApoB · lifetime exposure · Lp(a) · blood pressure · statins",
  },
  {
    n: "02",
    name: "Metabolism",
    href: "/metabolism/",
    status: "draft",
    markers: "A1C · insulin resistance (HOMA-IR) · metabolic syndrome · TG/HDL",
  },
  {
    n: "03",
    name: "Brain",
    href: "/brain/",
    status: "draft",
    markers: "blood pressure · A1C · ApoB · hearing · sleep · APOE",
  },
  {
    n: "04",
    name: "Cancer & early detection",
    href: null,
    status: "planned",
    markers:
      "age-appropriate screening · smoking · alcohol · obesity · family history",
  },
];

const stampClass: Record<Status, string> = {
  open: "stamp", // colour comes from .pillar-open .stamp

  draft: "stamp text-ink-muted",
  planned: "stamp border-dashed text-ink-faint",
};
const stampText: Record<Status, string> = {
  open: "Open",
  draft: "Draft",
  planned: "Planned",
};
---

<div class="not-prose my-10 overflow-hidden rounded-md border border-rule">
  <div class="border-b border-rule bg-well px-5 py-2.5">
    <span
      class="font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-ink-muted"
      >Longevity panel · five pillars</span
    >
  </div>
  {
    pillars.map((p) => {
      // The open row is inked with the slip palette (see .pillar-open). Its
      // colours have to come from that rule alone: Tailwind's utilities layer
      // sits after the components layer, so a `text-blood` here would win
      // regardless of specificity.
      const open = p.status === "open";
      const inner = (
        <>
          <span
            class:list={[
              "pillar-n pt-0.5 font-mono text-xs font-medium",
              !open && (p.href ? "text-blood" : "text-ink-faint"),
            ]}
          >
            {p.n}
          </span>
          <span class="min-w-0">
            <span
              class:list={[
                "pillar-name block text-base font-semibold",
                !open && (p.href ? "text-ink" : "text-ink-muted"),
              ]}
            >
              {p.name}
              {p.href && (
                <span
                  aria-hidden="true"
                  class:list={[
                    "ml-1 opacity-0 transition-opacity group-hover:opacity-100",
                    !open && "text-blood",
                  ]}
                >
                  →
                </span>
              )}
            </span>
            <span
              class:list={[
                "pillar-markers mt-1 block font-mono text-[11px] leading-relaxed",
                !open && "text-ink-muted",
              ]}
            >
              {p.markers}
            </span>
          </span>
          <span class={stampClass[p.status]}>{stampText[p.status]}</span>
        </>
      );
      const rowClass =
        "grid grid-cols-[auto_1fr_auto] items-start gap-x-4 border-b border-rule px-5 py-4 last:border-b-0";
      return p.href ? (
        <a
          href={p.href}
          class:list={[
            "group",
            rowClass,
            open ? "pillar-open" : "transition-colors hover:bg-blood-wash",
          ]}
        >
          {inner}
        </a>
      ) : (
        <div class={rowClass}>{inner}</div>
      );
    })
  }
</div>
