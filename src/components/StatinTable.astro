---
import { statinIntensity, sources } from "../lib/statins";
import Sources from "./ui/Sources.svelte";
---

<div class="card not-prose overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr
        class="text-left font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-ink-muted"
      >
        <th class="p-2 font-medium">Intensity</th>
        <th class="p-2 font-medium">LDL-C lowering</th>
        <th class="p-2 font-medium">Typical regimens</th>
        <th class="p-2 font-medium">When used</th>
      </tr>
    </thead>
    <tbody>
      {
        statinIntensity.map((b) => (
          <tr class="border-t border-rule">
            <td class="p-2 font-semibold capitalize">{b.intensity}</td>
            <td class="p-2 font-mono text-[13px]">{b.ldlReduction}</td>
            <td class="p-2">{b.regimens.join(", ")}</td>
            <td class="p-2">{b.whenTypicallyUsed}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <Sources sources={sources} />
</div>
