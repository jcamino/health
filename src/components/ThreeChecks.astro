---
// The heart page's action list: the three checks, in order of leverage. Lives
// as a component rather than inline MDX because formatters reflow JSX in MDX
// into block context, which splits styled <p> tags apart (MDX parses children
// that start on their own line as markdown blocks, nesting <p> inside <p>).
const checks = [
  {
    n: "01",
    href: "#lpa",
    action: "Check your Lp(a), once.",
    detail:
      "A one-time, mostly genetic blood test almost nobody gets. High Lp(a) quietly multiplies your risk, and about 1 in 5 people have it.",
  },
  {
    n: "02",
    href: "#apob",
    action: "Check your ApoB.",
    detail:
      'The real driver of atherosclerosis, and a better measure than standard LDL-C. Judged against optimal, most adults land in "High" or above.',
  },
  {
    n: "03",
    href: "#statins",
    action: "If your numbers are up, ask about a statin.",
    detail:
      "The highest-leverage lever. Guidelines now support starting as early as your 30s, and earlier means less lifetime exposure.",
  },
];
---

<aside class="not-prose my-8 overflow-hidden rounded-md border border-rule">
  <p
    class="border-b border-rule bg-well px-5 py-2.5 font-mono text-[10px] font-medium tracking-[0.16em] text-blood uppercase"
  >
    If you do only three things
  </p>
  <ol>
    {
      checks.map((c, i) => (
        <li
          class={`flex items-start gap-4 px-5 py-4 ${i < checks.length - 1 ? "border-b border-rule" : ""}`}
        >
          <span class="pt-0.5 font-mono text-xs font-medium text-blood">
            {c.n}
          </span>
          <p class="text-sm leading-relaxed">
            <a
              href={c.href}
              class="font-semibold underline decoration-blood underline-offset-[3px] hover:text-blood"
            >
              {c.action}
            </a>{" "}
            {c.detail}
          </p>
        </li>
      ))
    }
  </ol>
</aside>
